{
  "id": "executive_summary",
  "version": 1,
  "label": "Executive Summary",
  "description": "One page, synthesis-first -- the single most important chart per section, written for a stakeholder with two minutes.",
  "tone": "executive",
  "sections": [
    {
      "key": "analytics",
      "label": "Web Analytics",
      "charts": [
        {
          "caption": "Revenue by channel",
          "builder": "channel_revenue_bar_chart",
          "builder_args": ["by_channel"],
          "chart_type": "bar",
          "metric_paths": ["metrics.analytics.by_channel"],
          "shape": "records",
          "x_field": "channel",
          "y_field": "revenue_usd",
          "requires_columns": ["revenue_usd"]
        }
      ]
    },
    {
      "key": "seo",
      "label": "SEO & Site Health",
      "charts": [
        {
          "caption": "Site health",
          "builder": "seo_health_bar_chart",
          "builder_args": ["severity_counts"],
          "chart_type": "bar",
          "metric_paths": ["metrics.seo.severity_counts"],
          "shape": "dict_counts"
        }
      ]
    },
    {
      "key": "sales",
      "label": "Sales Performance",
      "charts": [
        {
          "caption": "Monthly revenue & win rate",
          "builder": "monthly_revenue_and_winrate_chart",
          "builder_args": ["_monthly"],
          "chart_type": "line",
          "metric_paths": ["series.sales.monthly"],
          "shape": "records",
          "x_field": "month",
          "y_field": "revenue_usd",
          "requires_columns": ["amount_usd"]
        }
      ]
    }
  ]
}
