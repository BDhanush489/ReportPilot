# Copy to .env (or set as real environment variables) and fill in what you need.
# Nothing in this file is a real secret -- it's a template.

# --- AI narrative provider (optional) --------------------------------------
# Without this, the backend automatically tries a local Ollama server next
# (see below), then falls back to a deterministic template narrative — the
# app runs end-to-end either way.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Used only if ANTHROPIC_API_KEY is not set. If an Ollama server is reachable
# at OLLAMA_BASE_URL, its OLLAMA_MODEL is used to write the report narrative
# for free, locally. Defaults shown below — override only if you're running
# Ollama elsewhere or pulled a different model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ---------------------------------------------------------------------------
# Track E1 — auth, tenancy, CSRF. Everything below is optional in the sense
# that the app still starts and every non-auth feature works without it, but
# Google login (and therefore actually using the app as more than one
# tenant) needs GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET set.
# ---------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------
# SQLite by default (zero local install). A later Postgres migration is a
# DATABASE_URL change + a new Alembic target, not a rewrite -- see app/db.py.
DATABASE_URL=sqlite:///./reportpilot.db

# --- Google OAuth login --------------------------------------------------------
# Create an OAuth Client (Web application type) in Google Cloud Console, with
# redirect URI http://localhost:8000/api/auth/google/callback (or your real
# BACKEND_BASE_URL + the same path once deployed). Blank on purpose here --
# login stays a clean 503 ("not configured") until both are set, rather than
# a fake-looking value that would make the app *think* it's configured when
# it isn't.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URLs (must be exact -- Google matches redirect URIs literally) -----------
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Comma-separated -- lets a real deployment allow e.g. both an apex and a www
# subdomain without a code change.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Session cookie ------------------------------------------------------------
SESSION_COOKIE_NAME=rp_session
SESSION_TTL_DAYS=30
# False for local http:// dev. Set True the moment this is served over https
# (browsers silently drop Secure cookies over plain http, so this can't just
# default True and "happen to work" locally).
COOKIE_SECURE=False
# Leave unset for localhost. Set to e.g. .yourdomain.com once frontend/backend
# are subdomains of one real domain, so the session cookie is shared between them.
# COOKIE_DOMAIN=
# "lax" works for localhost and for a same-parent-domain deploy (COOKIE_DOMAIN
# set above). Set to "none" ONLY if frontend and backend end up on two
# UNRELATED domains (e.g. two different free platform subdomains) -- a Lax
# cookie is never sent on cross-site fetch()/XHR, so login would silently
# appear to work while every API call after it 401s. SameSite=None requires
# COOKIE_SECURE=True, which any real https deploy needs anyway.
SESSION_COOKIE_SAMESITE=lax

# --- CSRF ------------------------------------------------------------------------
CSRF_COOKIE_NAME=rp_csrf

# --- Authlib's own short-lived OAuth handshake cookie (NOT the app session --
# see app/auth.py's module docstring). Generate a real random value for
# anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_STATE_SECRET_KEY=dev-only-insecure-key-change-me

# --- Service-to-service trigger for POST /api/schedules/run (e.g. a cron job
# with no human session). Leave blank to disable that path entirely -- only a
# session or this exact token can fire it.
SCHEDULER_SERVICE_TOKEN=

# --- Platform admin bootstrap --------------------------------------------------
# Comma-separated. On login, a matching email is auto-promoted to a
# cross-tenant platform admin (POST/GET /api/admin/*) -- see
# app/settings.py's own docstring. Only how the FIRST admin gets in; every
# admin after that is minted via POST /api/admin/users/{id}/promote.
PLATFORM_ADMIN_EMAILS=

# --- Optional data connectors ---------------------------------------------------
# GSC (Google Search Console) and GA4 credentials are per-client, not global --
# they're a service-account JSON key + site URL / property ID passed in the
# POST /api/data-sources/onboard request body for that client, same as a
# Postgres DSN or Snowflake password (see app/connectors/gsc_connector.py and
# ga4_connector.py's docstrings for how to create the service account). There
# is nothing to set here for either of them.
#
# PageSpeed Insights: in principle allows light anonymous use, but in
# practice the keyless global quota is usually already exhausted (confirmed
# live -- an unauthenticated call returns HTTP 429), so treat a key as
# required in practice. Free and instant: Google Cloud Console -> APIs &
# Services -> enable "PageSpeed Insights API" -> Credentials -> Create API
# key. No OAuth, no review. This is a fallback used only when a request
# doesn't pass its own api_key.
PAGESPEED_API_KEY=
