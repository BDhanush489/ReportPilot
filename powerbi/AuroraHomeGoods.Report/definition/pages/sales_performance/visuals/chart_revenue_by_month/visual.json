{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "chart_revenue_by_month",
  "position": {
    "x": 20,
    "y": 140,
    "z": 1000,
    "width": 610,
    "height": 340,
    "tabOrder": 1000
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "MonthName"
                }
              },
              "queryRef": "Date.MonthName",
              "nativeQueryRef": "MonthName"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "SalesDeals"
                    }
                  },
                  "Property": "Sales Revenue"
                }
              },
              "queryRef": "SalesDeals.Sales Revenue",
              "nativeQueryRef": "Sales Revenue"
            }
          ]
        }
      }
    }
  }
}